# =============================================================================
# Retinal Disease Classification API - Environment Configuration
# Copy to .env and customize for your environment
# =============================================================================

# --- Model ---
MODEL_PATH=models/model_vignn_rank1.pth
MODEL_NAME=vignn
NUM_CLASSES=45

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8080
DEBUG=false

# --- GPU ---
CUDA_VISIBLE_DEVICES=0             # Set to -1 for CPU-only
DEVICE=auto                        # auto | cpu | cuda
# Note: On HF Spaces, DEVICE=cpu and CUDA_VISIBLE_DEVICES=-1 are hardcoded
# in supervisord.conf (supervisor %(ENV_*)s expansion is not supported on HF Spaces)

# --- CORS ---
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Authentication ---
AUTH_ENABLED=false              # Set true in production
JWT_SECRET=change-me-in-production-use-env-var
JWT_EXPIRY_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | text

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Prediction Logging ---
PREDICTION_LOG_DIR=logs/predictions

# --- Uploads ---
MAX_UPLOAD_SIZE=10485760        # 10 MB

# --- Docker Hub ---
DOCKERHUB_USERNAME=                 # Docker Hub username
DOCKERHUB_TOKEN=                    # Docker Hub access token (dckr_pat_...)

# --- Hugging Face Spaces ---
HF_TOKEN=                           # huggingface.co access token
HF_SPACE=Mpairwe49/retinal-screening

# --- Kaggle (for dataset downloads) ---
KAGGLE_API_TOKEN=

# --- Fundus Gate v2 (fusion: statistical + learned MobileNetV3) ---
FUNDUS_GATE__ENABLED=true
FUNDUS_GATE__VERSION=v2                  # v1 | v2
FUNDUS_GATE__LEARNED_WEIGHT=0.4          # weight for learned gate in fusion
FUNDUS_GATE__MIN_CONFIDENCE=0.70         # fusion confidence threshold
FUNDUS_GATE__MODEL_PATH=weights/fundus_gate.pth
FUNDUS_GATE__VISUAL_EVIDENCE=false       # base64 heatmaps on rejection

# --- Agentic AI (LLM fallback chain: Claude → Groq → Deterministic) ---
# Anthropic Claude (primary — best for medical reasoning + tool use)
ANTHROPIC_API_KEY=
ANTHROPIC_ORG_ID=
AGENT_MODEL=claude-sonnet-4-20250514

# Groq (fallback — free tier, fast inference)
# Get free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.3

# Agent scheduling
AGENT_MONITOR_INTERVAL=60       # seconds
AGENT_GOVERNANCE_INTERVAL=300   # seconds

# =============================================================================
# Phase 1: Observability & MLOps (all opt-in, disabled by default)
# =============================================================================

# --- OpenTelemetry ---
TELEMETRY__ENABLED=false
TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
TELEMETRY__SERVICE_NAME=retinalai
TELEMETRY__SAMPLE_RATE=1.0

# --- MLflow Model Registry ---
MLFLOW__ENABLED=false
MLFLOW__TRACKING_URI=http://localhost:5000
MLFLOW__MODEL_NAME=retinalai-vignn
MLFLOW__EXPERIMENT_NAME=retinalai-production

# --- Active Learning Closed Loop ---
ACTIVE_LEARNING_LOOP__ENABLED=false
ACTIVE_LEARNING_LOOP__RETRAIN_THRESHOLD=150
ACTIVE_LEARNING_LOOP__QUEUE_DIR=data/active_learning

# --- Drift Detection ---
DRIFT__ENABLED=true
DRIFT__CHECK_INTERVAL=100
DRIFT__NANNYML_ENABLED=false
DRIFT__EVIDENTLY_ENABLED=false
DRIFT__ALERT_WEBHOOK_URL=

# =============================================================================
# Phase 2: Scalability & Security
# =============================================================================

# --- Ray Serve ---
RAY__ENABLED=false
RAY__SERVE_URL=http://localhost:8000

# --- Kafka ---
KAFKA__ENABLED=false
KAFKA__BOOTSTRAP_SERVERS=localhost:9092

# --- Mutual TLS ---
MTLS__ENABLED=false

# =============================================================================
# Phase 3: Governance & Edge
# =============================================================================

# --- Edge Inference ---
EDGE__ONNX_ENABLED=false
EDGE__COREML_ENABLED=false
EDGE__QUANTIZED_ENABLED=false

# --- Fairness Dashboard ---
FAIRNESS__ENABLED=false

# =============================================================================
# Phase 4: Future-Proofing
# =============================================================================

RESILIENCE__ENABLED=false
MULTIMODAL__ENABLED=false
FEDERATED__ENABLED=false

# =============================================================================
# Phase 5: Offline-First, Mobile-First, Voice-First (all opt-in)
# =============================================================================

# --- Offline RAG ---
OFFLINE_RAG__ENABLED=false
OFFLINE_RAG__INDEX_DIR=data/offline_rag/index
OFFLINE_RAG__SOURCE_DIR=data/offline_rag/source
OFFLINE_RAG__BUNDLES_DIR=data/offline_rag/bundles
OFFLINE_RAG__EMBEDDER_PATH=models/embedder/bge-m3-quantized.onnx
OFFLINE_RAG__TOP_K=5
OFFLINE_RAG__SIMILARITY_THRESHOLD=0.45
OFFLINE_RAG__SYNC_INTERVAL_S=3600
OFFLINE_RAG__COMPRESSION=gzip
OFFLINE_RAG__TARGET_BUNDLE_SIZE_MB=150

# --- Quantization Pipeline ---
QUANTIZATION__ENABLED=false
QUANTIZATION__ACTIVE_FORMAT=                    # gguf_q4_k_m | awq_4bit | onnx_int8
QUANTIZATION__MODELS_DIR=outputs/quantized
QUANTIZATION__TORCH_COMPILE_ENABLED=false
QUANTIZATION__TORCH_COMPILE_MODE=max-autotune   # default | reduce-overhead | max-autotune
QUANTIZATION__PREFIX_CACHE_ENABLED=false
QUANTIZATION__SPECULATIVE_DECODING_ENABLED=false
QUANTIZATION__SPECULATIVE_DRAFT_MODEL=
QUANTIZATION__EMBEDDER_FORMAT=
QUANTIZATION__VLLM_ENABLED=false
QUANTIZATION__MAX_FAITHFULNESS_DROP=0.04
QUANTIZATION__MAX_P95_LATENCY_MS=1800

# --- Voice-First Mobile ---
VOICE_FIRST__ENABLED=false
VOICE_FIRST__DEFAULT_LANGUAGE=en-ug
VOICE_FIRST__ASR_MODEL=whisper-tiny
VOICE_FIRST__ASR_MODEL_PATH=models/voice/whisper-tiny.onnx
VOICE_FIRST__TTS_ENGINE=piper
VOICE_FIRST__TTS_MODEL_PATH=models/voice/piper-en-ug.onnx
VOICE_FIRST__VAD_SENSITIVITY=0.6
VOICE_FIRST__BARGE_IN_ENABLED=true
VOICE_FIRST__SPEECH_RATE=1.0

# --- Mobile Bundle ---
MOBILE_BUNDLE__ENABLED=false
MOBILE_BUNDLE__MAX_BUNDLE_SIZE_MB=800
MOBILE_BUNDLE__TARGET_MODEL=gemma-2-2b-q4_k_m
MOBILE_BUNDLE__INCLUDE_VOICE_MODELS=true
MOBILE_BUNDLE__MIN_ANDROID_SDK=21
MOBILE_BUNDLE__MIN_RAM_MB=4096

# =============================================================================
# Phase 6: Subscription billing platform (all opt-in, disabled by default)
# Flipping these on activates the SaaS layer documented in
# docs/23-billing-platform.md.
# =============================================================================

# --- Sidecar Postgres (Option 2 — default for docker-compose & k8s) ---
# The `postgres` service in docker-compose.yml (or the StatefulSet in
# k8s/base/postgres-statefulset.yaml) provides the database. The api service
# computes DATABASE__URL from these values, so you usually only need to set
# POSTGRES_PASSWORD here.
DATABASE__ENABLED=true
DATABASE__URL=postgresql+asyncpg://optiscan:optiscan@postgres:5432/optiscan
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
DATABASE__ECHO=false

# Sidecar Postgres credentials (consumed by both the `postgres` and `api`
# services in docker-compose.yml). Override POSTGRES_PASSWORD in production.
POSTGRES_USER=optiscan
POSTGRES_PASSWORD=optiscan
POSTGRES_DB=optiscan

# --- Billing master switch + plan config ---
BILLING__ENABLED=true
BILLING__FREE_SCAN_LIMIT_MONTHLY=10
BILLING__FREE_PERIOD_DAYS=30
BILLING__QUOTA_CACHE_TTL_S=60
BILLING__ANNUAL_DISCOUNT_PCT=0.17

# --- Public app origin (used in email links + Stripe redirect URLs) ---
PUBLIC_APP_URL=https://www.optiscan.makstartup.com

# --- Auth (JWT) ---
# AUTH_ENABLED is already declared above — set it to true alongside the others
# to fully enable SaaS mode.
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Email (transactional: verify, magic link, reset, invite, renewal) ---
EMAIL__ENABLED=false
EMAIL__PROVIDER=console               # console | smtp | resend | sendgrid
EMAIL__FROM_ADDRESS=noreply@makstartup.com
EMAIL__FROM_NAME=OptiscanAI
EMAIL__RESEND_API_KEY=
EMAIL__SENDGRID_API_KEY=
EMAIL__SMTP_HOST=
EMAIL__SMTP_PORT=587
EMAIL__SMTP_USERNAME=
EMAIL__SMTP_PASSWORD=

# --- Stripe (cards) ---
STRIPE__ENABLED=false
STRIPE__API_KEY=
STRIPE__PUBLISHABLE_KEY=
STRIPE__WEBHOOK_SECRET=
STRIPE__SUCCESS_URL=https://www.optiscan.makstartup.com/app/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE__CANCEL_URL=https://www.optiscan.makstartup.com/app/billing
STRIPE__PORTAL_RETURN_URL=https://www.optiscan.makstartup.com/app/billing
STRIPE__CLINICIAN_MONTHLY_PRICE_ID=
STRIPE__CLINICIAN_ANNUAL_PRICE_ID=
STRIPE__PRACTICE_MONTHLY_PRICE_ID=
STRIPE__PRACTICE_ANNUAL_PRICE_ID=
STRIPE__PRACTICE_EXTRA_SEAT_MONTHLY_PRICE_ID=
STRIPE__PRACTICE_EXTRA_SEAT_ANNUAL_PRICE_ID=

# --- MTN MoMo + Airtel Money + Flutterwave ---
MOBILE_MONEY__ENABLED=false
MOBILE_MONEY__MTN_API_KEY=
MOBILE_MONEY__MTN_SUBSCRIPTION_KEY=
MOBILE_MONEY__MTN_ENVIRONMENT=sandbox
MOBILE_MONEY__MTN_CALLBACK_SECRET=
MOBILE_MONEY__AIRTEL_CLIENT_ID=
MOBILE_MONEY__AIRTEL_CLIENT_SECRET=
MOBILE_MONEY__AIRTEL_CALLBACK_SECRET=
MOBILE_MONEY__UGX_PER_USD=3800

FLUTTERWAVE__ENABLED=false
FLUTTERWAVE__SECRET_KEY=
FLUTTERWAVE__PUBLIC_KEY=
FLUTTERWAVE__SECRET_HASH=
