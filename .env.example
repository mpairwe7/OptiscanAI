# Environment Variables Template for Retinal Disease Screening Application
# Copy this file to .env and update values for your deployment

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Path to the trained ViGNN model file
MODEL_PATH=models/model_vignn_rank1.pth

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================

# FastAPI server host (0.0.0.0 for all interfaces)
API_HOST=0.0.0.0

# FastAPI server port
API_PORT=8080

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# STREAMLIT WEB UI CONFIGURATION
# =============================================================================

# Streamlit server port
STREAMLIT_SERVER_PORT=8501

# Streamlit server host address
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Run Streamlit in headless mode (no browser)
STREAMLIT_SERVER_HEADLESS=true

# Disable Streamlit usage statistics collection
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# =============================================================================
# GPU CONFIGURATION
# =============================================================================

# CUDA visible devices (GPU IDs to use, comma-separated)
CUDA_VISIBLE_DEVICES=0

# =============================================================================
# NGROK TUNNELING CONFIGURATION (Optional)
# =============================================================================

# Ngrok server region (us, eu, ap, au, sa, jp, in)
NGROK_REGION=us

# Port to tunnel through ngrok (should match Streamlit port)
NGROK_PORT=8501

# Ngrok logging level (stdout, stderr, or file path)
NGROK_LOG_LEVEL=stdout

# Basic authentication for ngrok tunnel (username:password format)
# Leave empty to disable authentication
NGROK_BASIC_AUTH=

# OAuth provider for ngrok tunnel (google, github, gitlab, etc.)
# Leave empty to disable OAuth
NGROK_OAUTH_PROVIDER=

# =============================================================================
# CRANE CLOUD SPECIFIC CONFIGURATION
# =============================================================================

# Add any additional Crane Cloud specific environment variables here
# For example:
# CRANE_CLOUD_PROJECT_ID=your_project_id
# CRANE_CLOUD_ENVIRONMENT=production