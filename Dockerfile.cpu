# ============================================================================
# CPU-Only Production Dockerfile
# ============================================================================
FROM ubuntu:22.04

LABEL maintainer="retinal-screening-team"
LABEL description="CPU Retinal Disease Screening API"
LABEL version="2.0.0"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y \
    python3 python3-venv python3-pip \
    build-essential git curl ca-certificates \
    libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir ".[deploy]"

RUN /opt/venv/bin/pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY src/ ./src/
COPY backend/ ./backend/
COPY configs/ ./configs/

RUN mkdir -p models/checkpoints logs uploads && chmod -R 755 /app

ENV MODEL_PATH=${MODEL_PATH:-src/models/model_vignn_rank1.pth} \
    API_HOST=${API_HOST:-0.0.0.0} \
    API_PORT=${API_PORT:-8080} \
    CUDA_VISIBLE_DEVICES=-1

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8080"]
