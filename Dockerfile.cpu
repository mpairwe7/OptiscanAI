# ============================================================================
# CPU-Only Production Dockerfile for Crane Cloud Deployment
# Uses Ubuntu base image without CUDA for CPU-only inference
# ============================================================================
FROM ubuntu:22.04

# Metadata
LABEL maintainer="retinal-screening-team"
LABEL description="CPU-based Retinal Disease Screening API for Crane Cloud"
LABEL version="2.1.0-cpu"

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-pip \
    python3-dev \
    build-essential \
    git \
    wget \
    ca-certificates \
    curl \
    gnupg \
    unzip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Ensure `python` points to python3
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt /app/requirements.txt

# Create virtual environment and install requirements
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r /app/requirements.txt

# Install CPU-only PyTorch
RUN /opt/venv/bin/pip install --no-cache-dir \
    torch==2.0.1+cpu \
    torchvision==0.15.2+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# Copy application code
COPY src/ ./src/
COPY models/ ./models/
COPY deployment/ ./deployment/

# Create necessary directories with proper permissions
RUN mkdir -p models/checkpoints models/exports logs uploads \
    && chmod -R 755 /app

# Copy and setup entrypoint script
COPY start_cpu.sh /app/start.sh
RUN chmod +x /app/start.sh

# Set environment variables for CPU-only operation
ENV CUDA_VISIBLE_DEVICES="" \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    API_HOST=0.0.0.0 \
    API_PORT=8080 \
    LOG_LEVEL=INFO

# Expose ports for API and Streamlit
EXPOSE 8080 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || curl -f http://localhost:8501 || exit 1

# Default command
CMD ["/app/start.sh"]