# https://editorconfig.org — keep consistent whitespace across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Web / config files use 2-space indentation
[*.{js,jsx,ts,tsx,json,jsonc,css,scss,html,yml,yaml,toml,mjs,cjs}]
indent_size = 2

# Python — 4-space, 100-col (matches ruff/black config in pyproject.toml)
[*.py]
indent_size = 4
max_line_length = 100

# Markdown — preserve trailing spaces (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs
[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
